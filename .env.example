# Copy to .env and fill in:  cp .env.example .env
# The CLI, the API and scripts/measure_llm.py read .env automatically. Values exported in
# the shell win over this file. No .env (or an empty LLM_API_KEY) → rule extractor only.
# The test suite never reads .env.

# LLM extractor (optional). Any OpenAI-compatible endpoint works; defaults target Qwen.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=20

# SQLite database file used by the HTTP API (default ./data/listings.db).
DB_PATH=./data/listings.db
