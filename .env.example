# Copy to .env and fill in:  cp .env.example .env
# The CLI and the API read .env automatically. Values exported in the shell win over
# this file. No .env (or an empty LLM_API_KEY) → rule extractor only.
# The test suite never reads .env.

# LLM extractor (optional). Any OpenAI-compatible endpoint works; defaults target Qwen.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# Max-tier models need up to ~55s on multi-listing messages (measured, see README).
LLM_TIMEOUT_SECONDS=60

# Cost tracking (llm_runs table). USD per 1M tokens for LLM_MODEL; the API returns tokens,
# not cost. Official prices: https://www.alibabacloud.com/help/en/model-studio/model-pricing
# (International, checked 2026-11-11): qwen-plus 0.4 / 1.2 (non-thinking), qwen3.8-max 2 / 6.
# Leave empty to record tokens only.
LLM_INPUT_PRICE_PER_M=0.4
LLM_OUTPUT_PRICE_PER_M=1.2

# SQLite database file used by the HTTP API (default ./data/listings.db).
DB_PATH=./data/listings.db
