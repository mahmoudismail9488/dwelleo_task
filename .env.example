# LLM extractor (optional). Leave LLM_API_KEY empty to use the rule-based extractor only.
# Any OpenAI-compatible endpoint works; defaults target Qwen (Alibaba Cloud Model Studio).
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=20

# SQLite database file used by the HTTP API.
DB_PATH=./data/listings.db
